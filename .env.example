# Synonym Quest — пример переменных окружения.
# Скопируйте этот файл в .env и подставьте реальные значения.
# .env в .gitignore и НЕ коммитится.

# Токен бота в мессенджере MAX
BOT_TOKEN=replace_me_later

# Подключение к PostgreSQL (asyncpg-драйвер)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/synonym_quest

# Подключение к Redis (DB 0)
REDIS_URL=redis://localhost:6379/0

# Уровень логирования: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Режим доставки апдейтов: false = long polling, true = webhook
USE_WEBHOOK=false

# Публичный URL вебхука (используется только если USE_WEBHOOK=true)
WEBHOOK_URL=
